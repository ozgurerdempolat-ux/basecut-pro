{
  "name": "basecut",
  "version": "1.0.0",
  "description": "BaseCut Pro \u2014 \u00fccretsiz, hafif, profesyonel video kurgu program\u0131. The Base Social",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "author": "The Base Social",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "immer": "^11.1.21",
    "nanoid": "^6.0.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "productName": "BaseCut Pro",
  "type": "commonjs",
  "build": {
    "appId": "com.thebasesocial.basecut",
    "productName": "BaseCut Pro",
    "copyright": "\u00a9 2026 The Base Social",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "fileAssociations": [
      {
        "ext": "basecut",
        "name": "BaseCut Projesi",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BaseCut-Pro-${version}-Windows-Kurulum.${ext}",
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/linux/**",
        "!node_modules/ffprobe-static/bin/*/ia32/**",
        "!node_modules/ffmpeg-static/*.README"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "BaseCut Pro"
    },
    "portable": {
      "artifactName": "BaseCut-Pro-${version}-Windows-Tasinabilir.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.video",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "BaseCut Pro, seslendirme (dış ses) kaydı için mikrofonunuzu kullanır."
      },
      "artifactName": "BaseCut-Pro-${version}-Mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "files": [
        "!node_modules/ffprobe-static/bin/win32/**",
        "!node_modules/ffprobe-static/bin/linux/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "artifactName": "BaseCut-Pro-${version}-Linux-${arch}.${ext}",
      "files": [
        "!node_modules/ffprobe-static/bin/win32/**",
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/*/ia32/**"
      ]
    },
    "publish": null,
    "compression": "maximum",
    "electronLanguages": [
      "tr",
      "en-US",
      "en-GB",
      "de",
      "fr",
      "es",
      "ar",
      "ru"
    ],
    "extraResources": [
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  },
  "homepage": "https://github.com/ozgurerdempolat-ux/basecut-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozgurerdempolat-ux/basecut-pro"
  }
}