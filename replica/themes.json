{
 "_about": "Themes reviews.py sorts feedback into. Patterns are Python regular expressions, matched case-insensitively against the review text. kind is complaint (something users hate) or request (something users want that is missing). Edit freely: add the app category's own words (for a booking app: double booking, time zone, no-show).",
 "request_patterns": [
  "\\bi wish\\b",
  "\\bplease add\\b",
  "\\bwould be (nice|great|good|helpful)\\b",
  "\\bwould love\\b",
  "\\bneeds? (a|an|the|to|more)\\b",
  "\\bno way to\\b",
  "\\bthere'?s no (way|option)\\b",
  "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
  "\\b(missing|lacks|lacking)\\b",
  "\\bdoesn'?t (have|support|let|allow)\\b",
  "\\bif only\\b",
  "\\bfeature request\\b",
  "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
 ],
 "themes": [
  {
   "id": "crashes",
   "label": "Crashes, freezes, instability",
   "kind": "complaint",
   "patterns": [
    "\\bcrash",
    "\\bfreez",
    "\\bunstable\\b",
    "\\binstabil",
    "\\bjanky\\b",
    "\\breliab",
    "\\bbug",
    "\\brebooting\\b"
   ]
  },
  {
   "id": "performance",
   "label": "Heavy on hardware, slow on big projects",
   "kind": "complaint",
   "patterns": [
    "resource.intensive",
    "\\bdemanding\\b",
    "\\bslow",
    "\\bgrinding halt\\b",
    "\\bRAM\\b",
    "\\bGPU\\b",
    "recursos de hardware",
    "\\b4K\\b",
    "\\b6K\\b",
    "\\bperformance\\b"
   ]
  },
  {
   "id": "complexity",
   "label": "Learning curve and dense UI",
   "kind": "complaint",
   "patterns": [
    "learning curve",
    "\\bcomplex",
    "\\boverwhelming\\b",
    "beginner",
    "\\bconfuses\\b",
    "\\bdense\\b",
    "hidden behind menus",
    "\\bUX\\b",
    "\\bnew UI\\b",
    "intuitive",
    "complexit"
   ]
  },
  {
   "id": "cloud",
   "label": "Cloud dependency / rental-only",
   "kind": "complaint",
   "patterns": [
    "\\bcloud\\b",
    "lost access",
    "buy the product"
   ]
  },
  {
   "id": "export",
   "label": "Slow or broken export",
   "kind": "complaint",
   "patterns": [
    "\\bexport"
   ]
  },
  {
   "id": "aibloat",
   "label": "AI features as bloat",
   "kind": "complaint",
   "patterns": [
    "\\bbloat\\b",
    "AI for the sake"
   ]
  },
  {
   "id": "color",
   "label": "Weak color tools",
   "kind": "complaint",
   "patterns": [
    "color correct",
    "\\bLUT\\b"
   ]
  },
  {
   "id": "regressions",
   "label": "Updates break things / step backwards",
   "kind": "complaint",
   "patterns": [
    "step backwards",
    "\\bv24\\b",
    "\\b24\\.5\\b",
    "messed up",
    "old code",
    "start from scratch"
   ]
  },
  {
   "id": "switch",
   "label": "Switching to DaVinci Resolve",
   "kind": "complaint",
